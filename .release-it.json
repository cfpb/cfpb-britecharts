{
    "git": {
        "commit": true,
        "tag": true,
        "push": false,
        "commitMessage": "chore(release): ${version}"
    },
    "npm": {
        "publish": false
    },
    "github": {
        "release": false
    },
    "plugins": {
        "@release-it/conventional-changelog": {
            "preset": "angular",
            "infile": "CHANGELOG.md"
        }
    }
}
